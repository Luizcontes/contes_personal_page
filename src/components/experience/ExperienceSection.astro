---
import './experience-section.css';
---

<div class="experience-container">
	<div class="experience-intro">
		<h2 data-i18n="section.experience">Work Experience</h2>
		<p class="experience-intro-copy" data-i18n="section.experience.intro">
			A timeline of the roles, projects, and lessons that have shaped how I build software.
		</p>
	</div>
	<ol class="experience-timeline">
		<li class="experience-entry">
			<div class="experience-entry-marker" aria-hidden="true"></div>
			<div class="experience-entry-content">
				<p class="experience-period" data-i18n="experience.placeholder.period">Present</p>
				<h3 data-i18n="experience.placeholder.role">Software Engineer</h3>
				<p class="experience-company" data-i18n="experience.placeholder.company">
					Your Company
				</p>
				<p class="experience-description" data-i18n="experience.placeholder.description">
					Work experience details will be added here, including responsibilities, technical decisions, and measurable outcomes.
				</p>
			</div>
		</li>
		<li class="experience-entry">
			<div class="experience-entry-marker" aria-hidden="true"></div>
			<div class="experience-entry-content">
				<p class="experience-period" data-i18n="experience.placeholder.previousPeriod">
					Previous role
				</p>
				<h3 data-i18n="experience.placeholder.previousRole">Previous Role</h3>
				<p class="experience-company" data-i18n="experience.placeholder.previousCompany">
					Previous Company
				</p>
				<p class="experience-description" data-i18n="experience.placeholder.previousDescription">
					Add a concise summary of the work, technologies, and impact from this role.
				</p>
			</div>
		</li>
	</ol>
</div>

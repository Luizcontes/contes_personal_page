---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	formattedDate: string;
}

const { post, formattedDate } = Astro.props;
---

<section class="home-section blog-post-section">
	<article class="post">
		<header class="post-header">
			<div class="post-meta">
				<time datetime={post.data.date.toISOString()}>{formattedDate}</time>
				<span class="post-tags">
					{post.data.tags.map((tag) => (
						<span class="blog-tag">{tag}</span>
					))}
				</span>
			</div>
			<h1 class="post-title">{post.data.title}</h1>
			<p class="post-description">{post.data.description}</p>
		</header>
		<div class="post-body prose">
			{post.data.cover && (
				<img
					class="post-cover"
					src={post.data.cover}
					alt=""
					width="1200"
					height="630"
					loading="eager"
					decoding="async"
				/>
			)}
			<slot />
		</div>
		<footer class="post-footer">
			<a href="/blog" class="post-back">&larr; Back to Blog</a>
		</footer>
	</article>
</section>

<style>
	.post {
		width: 100%;
		max-width: 72ch;
		min-width: 0;
		margin: 0 auto;
		padding: var(--space-8) 0;
	}

	.post-header {
		margin-bottom: var(--space-8);
		display: grid;
		gap: var(--space-4);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.blog-tag {
		background-color: var(--color-border);
		color: var(--color-text-muted);
		border-radius: var(--radius-sm);
		padding: 0.125rem var(--space-2);
		font-size: 0.75rem;
	}

	.post-title {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.15;
	}

	.post-description {
		margin: 0;
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	.post-cover {
		width: 100%;
		height: auto;
		display: block;
		margin: 0 0 var(--space-8);
		border-radius: var(--radius-md);
	}

	.post-body {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		overflow-x: clip;
		overflow-wrap: anywhere;
	}

	.post-body :global(*) {
		max-width: 100%;
		min-width: 0;
	}

	.prose :global(img),
	.prose :global(video),
	.prose :global(iframe),
	.prose :global(svg) {
		max-width: 100%;
	}

	.prose :global(img),
	.prose :global(video) {
		height: auto;
	}

	.prose :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
	}

	.prose :global(h2) {
		margin: var(--space-8) 0 var(--space-4);
		font-size: clamp(1.25rem, 2.5vw, 1.625rem);
		line-height: 1.25;
	}

	.prose :global(h3) {
		margin: var(--space-6) 0 var(--space-3);
		font-size: clamp(1.0625rem, 2vw, 1.25rem);
	}

	.prose :global(p) {
		margin: 0 0 var(--space-4);
		line-height: 1.75;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 var(--space-4);
		padding-left: var(--space-6);
		line-height: 1.75;
	}

	.prose :global(li) {
		margin-bottom: var(--space-2);
	}

	.prose :global(pre) {
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-4);
		overflow-x: auto;
		margin: 0 0 var(--space-4);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		line-height: 1.6;
		white-space: pre-wrap;
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.875em;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 0.125em 0.35em;
	}

	.prose :global(pre code) {
		background: none;
		border: none;
		padding: 0;
		font-size: inherit;
	}

	.prose :global(blockquote) {
		border-left: 3px solid var(--color-accent-cyan);
		margin: 0 0 var(--space-4);
		padding: var(--space-3) var(--space-4);
		color: var(--color-text-muted);
	}

	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: var(--space-8) 0;
	}

	.post-footer {
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.post-back {
		font-size: 0.9375rem;
		text-decoration: none;
		color: var(--color-text-muted);
		transition: color var(--duration-base) var(--ease-standard);
	}

	.post-back:hover {
		color: var(--color-accent-cyan);
	}
</style>
